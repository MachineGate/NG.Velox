<Window x:Class="NG.Velox.Examples.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NG.Velox.Examples"
        xmlns:vm="clr-namespace:NG.Velox.Examples"
        xmlns:helix="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <local:DoubleToTimeConverter x:Key="TimeConverter"/>

        <Style x:Key="SettingInputStyle" TargetType="TextBox">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0" 
                     Text="{Binding CodeText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" 
                     AcceptsTab="True" 
                     VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" 
                     FontSize="13" 
                     Padding="5" 
                     BorderThickness="0,0,1,0" 
                     BorderBrush="#CCCCCC"/>

            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          Background="#E0E0E0"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <helix:HelixViewport3D Grid.Column="0" x:Name="Viewport" ShowCoordinateSystem="True">
                        <helix:DefaultLights/>
                        <helix:LinesVisual3D Points="{Binding TrajectoryPoints}" Thickness="2" Color="Blue"/>
                        <helix:SphereVisual3D Center="{Binding ToolPosition}" Radius="1.5">
                            <helix:SphereVisual3D.Material>
                                <DiffuseMaterial Brush="Red"/>
                            </helix:SphereVisual3D.Material>
                        </helix:SphereVisual3D>
                    </helix:HelixViewport3D>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Width="260" Background="#F1F3F5">
                        <StackPanel Margin="10">
                            <TextBlock Text="Kernel Settings" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Foreground="#495057"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Max Acceleration:" VerticalAlignment="Center" Foreground="#343A40"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInputStyle}" Text="{Binding MaxAcceleration, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Max Jerk:" VerticalAlignment="Center" Foreground="#343A40"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInputStyle}" Text="{Binding MaxJerk, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Junction Deviation:" VerticalAlignment="Center" Foreground="#343A40"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInputStyle}" Text="{Binding JunctionDeviation, Mode=TwoWay}"/>
                            </Grid>
                            
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Min Block Length:" VerticalAlignment="Center" Foreground="#343A40"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInputStyle}" Text="{Binding MinBlockLength, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Chordal Tolerance:" VerticalAlignment="Center" Foreground="#343A40"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInputStyle}" Text="{Binding ChordalTolerance, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Max Linear Step:" VerticalAlignment="Center" Foreground="#343A40"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInputStyle}" Text="{Binding MaxLinearStep, Mode=TwoWay}"/>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="LabelGroup"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Label Grid.Column="0" Content="Min Step Length:" VerticalAlignment="Center" Foreground="#343A40"/>
                                <TextBox Grid.Column="1" Style="{StaticResource SettingInputStyle}" Text="{Binding MinStepLength, Mode=TwoWay}"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Border Grid.Row="1" Background="#F8F9FA" Padding="10,5,30,5" BorderBrush="#E9ECEF" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" 
                                Maximum="{Binding TotalTime}" 
                                Value="{Binding CurrentTime, Mode=TwoWay}" 
                                TickFrequency="1" 
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" Width="110">
                            <TextBlock Text="{Binding CurrentTime, Converter={StaticResource TimeConverter}}"/>
                            <TextBlock Text=" / "/>
                            <TextBlock Text="{Binding TotalTime, Converter={StaticResource TimeConverter}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <GridSplitter Grid.Row="1" 
                      Height="5" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Center" 
                      Background="#E0E0E0"/>

        <GroupBox Grid.Row="2" Header="Error log" Margin="5" Padding="0">
            <ListBox ItemsSource="{Binding ErrorsCollection}" 
                     Foreground="Red" 
                     FontFamily="Consolas"
                     FontSize="12"
                     BorderThickness="0"/>
        </GroupBox>

        <Border Grid.Row="3" Background="#E9ECEF" Padding="15,10" BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{Binding PlayButtonText}" 
                        Command="{Binding PlayPauseCommand}" 
                        Width="100" Height="30" 
                        FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
